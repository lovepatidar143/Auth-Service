# ============================================================
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit the real .env file (it is listed in .gitignore).
# ============================================================

NODE_ENV=development
PORT=8000
APP_NAME="Auth Service"
# Public URL of THIS API (used to build the email-verification link)
APP_BASE_URL=http://localhost:8000

# Comma separated list of frontend origins allowed to call the API. "*" is NOT allowed (cookies are used).
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the app (0 = none). Needed for correct rate limiting in production.
TRUST_PROXY=0

# ---------------- Database ----------------
MONGODB_URI=mongodb://127.0.0.1:27017/auth-service

# ---------------- Tokens ----------------
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# They must be >= 32 characters and DIFFERENT from each other.
ACCESS_TOKEN_SECRET=replace-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace-me-with-another-long-random-string
REFRESH_TOKEN_EXPIRY=7d

# ---------------- Cookies ----------------
# lax (default) | strict | none  ("none" is needed only if frontend and API are on different sites; requires HTTPS)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# ---------------- Security policy (all optional) ----------------
BCRYPT_SALT_ROUNDS=12
# true = users must verify their email before they can log in
REQUIRE_EMAIL_VERIFICATION=true
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
MAX_SESSIONS_PER_USER=10
REFRESH_REUSE_GRACE_SECONDS=10
RATE_LIMIT_ENABLED=true

# ---------------- Email (SMTP) ----------------
# Leave MAILTRAP_SMTP_HOST empty in development and emails are printed to the console instead.
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
MAIL_FROM="Auth Service <no-reply@example.com>"
# Frontend page that shows the "choose a new password" form. The reset token is appended: <url>/<token>
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password
