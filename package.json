{
    "name": "auth-service",
    "version": "1.0.0",
    "description": "Production-ready authentication and authorization backend: JWT access/refresh tokens, per-device sessions, refresh-token rotation with reuse detection, rate limiting, account lockout, RBAC and email flows.",
    "main": "src/index.js",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "nodemon src/index.js",
        "start": "node src/index.js",
        "test": "node --test --test-concurrency=1 tests/*.test.js",
        "seed:admin": "node src/scripts/seed-admin.js",
        "format": "prettier --write ."
    },
    "keywords": [
        "authentication",
        "authorization",
        "jwt",
        "refresh-token",
        "express",
        "mongodb",
        "rate-limiting",
        "rbac"
    ],
    "author": "Love Patidar",
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.8",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "express-validator": "^7.3.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mailgen": "^2.0.36",
        "mongoose": "^9.11.2",
        "morgan": "^1.12.1",
        "nodemailer": "^10.1.2"
    },
    "devDependencies": {
        "mongodb-memory-server": "^11.3.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.10",
        "supertest": "^7.3.1"
    }
}
